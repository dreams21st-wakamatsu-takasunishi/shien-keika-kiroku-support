# Browser-safe Supabase project settings.
# Copy this file to .env.local. Never put the service-role key here.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"

# Set true only when checking the UI with browser-local sample data.
# Leave false or unset in production.
VITE_FORCE_LOCAL_MODE="false"

# Web Push public key. Generate the VAPID key pair once, put the public key
# here, and register the matching private key as a Supabase secret.
VITE_VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"

# GEMINI_API_KEY is configured only as a Supabase Edge Function secret:
# supabase secrets set GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# supabase secrets set VAPID_PUBLIC_KEY="..." VAPID_PRIVATE_KEY="..." VAPID_SUBJECT="mailto:admin@example.com" PUBLIC_APP_URL="https://OWNER.github.io/REPOSITORY/"
# supabase secrets set CALENDAR_REMINDER_CRON_SECRET="A_LONG_RANDOM_VALUE"
# GOOGLE_MAPS_API_KEY is configured only as a Supabase Edge Function secret:
# supabase secrets set GOOGLE_MAPS_API_KEY="YOUR_SERVER_SIDE_ROUTES_API_KEY"
# Use a separate server-side key for address conversion when possible:
# supabase secrets set GOOGLE_GEOCODING_API_KEY="YOUR_SERVER_SIDE_GEOCODING_KEY" GEOCODING_DAILY_LIMIT="500"

# Browser key for displaying Google Maps. This value is included in the public
# browser bundle, so restrict it in Google Cloud to this GitHub Pages website
# and to Maps JavaScript API only. Create a production JavaScript map ID too.
VITE_GOOGLE_MAPS_BROWSER_KEY="YOUR_WEBSITE_RESTRICTED_MAPS_JAVASCRIPT_KEY"
VITE_GOOGLE_MAPS_MAP_ID="YOUR_PRODUCTION_JAVASCRIPT_MAP_ID"
