# Browser-safe Supabase project settings.
# Copy this file to .env.local. Never put the service-role key here.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"

# Web Push public key. Generate the VAPID key pair once, put the public key
# here, and register the matching private key as a Supabase secret.
VITE_VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"

# GEMINI_API_KEY is configured only as a Supabase Edge Function secret:
# supabase secrets set GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# supabase secrets set VAPID_PUBLIC_KEY="..." VAPID_PRIVATE_KEY="..." VAPID_SUBJECT="mailto:admin@example.com" PUBLIC_APP_URL="https://OWNER.github.io/REPOSITORY/"
